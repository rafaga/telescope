shape: sequence_diagram

log: "EVE chat log\n(UTF-16LE file)"
watcher: "IntelEventHandler\n(notify thread)"
reader: "intel/reader.rs\n(reader thread)"
detection: "intel/detection.rs\nExecutor (thread)"
dispatch: "intel/dispatch.rs\n(dispatch thread)"
audio: "audio.rs\nAudioHandle (thread)"
app: "TelescopeApp\n(UI thread)"
maps: "Map panes"

log -> watcher: "line appended (filesystem event)"
watcher -> watcher: "IntelLogName::parse:\nmonitored channel?"
watcher -> reader: "file name (std mpsc)"
reader -> log: "read the bytes added since the last read"
reader -> reader: "decode UTF-16LE, parse lines\n(ChatLogSource)"
reader -> app: "Message::ChannelActivity"
reader -> detection: "InputEvent per line"
detection -> detection: "Executor::run -> Activations"
detection -> dispatch: "DetectedLine"
dispatch -> dispatch: "read AlarmShared\n(settings, locations, jump graph)"
dispatch -> maps: "visual: MapSync::SystemAlert"
dispatch -> maps: "tooltip: MapSync::SystemTooltip\ncenter: MapSync::CenterOn"
dispatch -> audio: "sound"
dispatch -> app: "log: Message::GenericNotification\n(status log)"
