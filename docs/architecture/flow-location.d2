shape: sequence_diagram

watchdog: "Watchdog\n(start_watchdog)"
esi: "ESI\n(EsiManager)"
app: "TelescopeApp"
maps: "Map panes"

watchdog -> esi: "valid_token? refresh_token if not"
watchdog -> esi: "get_location(character)"
esi -> watchdog: "solar system id"
watchdog -> app: "Message::PlayerNewLocation\n(only if it changed)"
app -> app: "update_player_location:\nstore the location"
app -> maps: "move the character's marker\n(directly, every pane)"
watchdog -> app: "401 / 403 or refresh failed:\nnotification, that character paused"
watchdog -> watchdog: "sleep 30 s, repeat\n(polls at once on CharacterSync::Add)"
app -> watchdog: "CharacterSync::Add / Remove"
