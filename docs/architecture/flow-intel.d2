shape: sequence_diagram

log: "EVE chat log\n(UTF-16LE file)"
watcher: "IntelEventHandler\n(notify thread)"
app: "TelescopeApp\nevent_manager"
input: "intel/input.rs\nChatLogSource"
detection: "intel/detection.rs\nExecutor (thread)"
process: "intel/mod.rs\nprocess_detected_line"
status: "Status log\n(notifications.rs)"
sde: "SdeManager"
maps: "Map panes"

log -> watcher: "line appended (filesystem event)"
watcher -> watcher: "IntelLogName::parse:\nmonitored channel?"
watcher -> app: "Message::IntelFileChanged(file name)"
app -> input: "load_intel_file"
input -> log: "read the bytes added since the last read"
input -> input: "decode UTF-16LE, parse lines"
input -> detection: "InputEvent per line"
detection -> detection: "Executor::run -> Activations"
detection -> process: "Activations"
process -> sde: "SystemResolver (system ids)"
process -> maps: "visual: MapSync::SystemAlert"
process -> maps: "tooltip: MapSync::SystemTooltip"
process -> status: "log: GenericNotification"
